# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Local PostgreSQL. Create the role and database once:
#   sudo -u postgres psql
#   create role rainbow500 with login password 'something-long-and-random';
#   create database rainbow500 owner rainbow500;
# Then apply the schema:
#   psql "$DATABASE_URL" -f db/schema.sql
#
# The cluster should listen on localhost only. Nothing outside the machine needs
# to reach it: the browser reads the shirt through GET /api/squares, and every
# write goes through an API route.
DATABASE_URL=postgresql://rainbow500:PASSWORD@127.0.0.1:5432/rainbow500

# Your site's real public URL. Netcash's Accept/Decline/Notify URLs are
# configured separately in the Netcash dashboard (see README), not read from
# this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Port the Node process listens on. Only needed where something is
# reverse-proxying to it, as on the production box.
# PORT=3000

# Netcash Pay Now. Unlike Payfast, Netcash has no public shared sandbox -
# you need a real Netcash account with a Pay Now service enabled, then tick
# "Make test mode active" on that service's NetConnector profile to test
# without moving real money.
NETCASH_SERVICE_KEY=
# Netcash's generic/default software-vendor key - fine to leave as-is unless
# Netcash has issued you your own.
NETCASH_VENDOR_KEY=24ade73c-98cf-47b3-99be-cc7b867b3080

# Protects /admin (the orders dashboard) with HTTP Basic Auth. Pick your own
# values - this is the only thing standing between the public internet and
# every buyer's email/phone/payment status. If either is unset, /admin returns
# 500 rather than opening up.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Transactional email (Resend) --------------------------------------------
# Two messages, both from app/api/netcash/notify: the buyer's receipt once a
# payment confirms, and an alert to the club when an order lands in `conflict`
# (paid, but the squares had already gone, so someone is owed a refund).
#
# All three may be left blank. With no key the app logs what it would have sent
# and carries on, which is what a local copy should do, and a mail failure can
# never break a payment callback.
#
# Before the first real send, hbufc.co.za has to be verified in the Resend
# dashboard and its records added to Cloudflare: a DKIM TXT at
# resend._domainkey, plus an MX and a TXT on the `send` subdomain. That domain
# sits at DMARC p=reject, so an unauthenticated send is refused outright rather
# than landing in spam. Take the exact values from the dashboard, they are per
# account, and set every record to DNS only (grey cloud) in Cloudflare.
RESEND_API_KEY=
# The visible From address, on the verified domain. Not a noreply: buyers reply
# to receipts, so this wants to be a real Workspace alias or group that someone
# reads. There is no fallback to Resend's shared onboarding@resend.dev sandbox
# address: if this is unset the app refuses to send and says so, rather than
# quietly mailing buyers from a resend.dev address that nobody recognises.
RESEND_FROM=
# Where replies to a receipt should land. If RESEND_FROM is a no-reply address
# this matters: buyers do reply to a receipt for a R2,000 payment. Leave it
# blank and the receipt simply stops inviting a reply, rather than inviting one
# into a black hole.
MAIL_REPLY_TO=
# Where the conflict alert goes. Internal, so a shared club address is right.
# Unset means nobody is told when a buyer needs a refund.
ADMIN_ALERT_EMAIL=

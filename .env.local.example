# Copy this file to .env.local and fill in the Supabase values from your
# project's Settings -> API page. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your site's real public URL. Used in the README's setup notes; Netcash's
# Accept/Decline/Notify URLs themselves are configured separately in the
# Netcash dashboard (see README), not read from this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netcash Pay Now. Unlike Payfast, Netcash has no public shared sandbox -
# you need a real Netcash account with a Pay Now service enabled, then tick
# "Make test mode active" on that service's NetConnector profile to test
# without moving real money.
NETCASH_SERVICE_KEY=
# Netcash's generic/default software-vendor key - fine to leave as-is unless
# Netcash has issued you your own.
NETCASH_VENDOR_KEY=24ade73c-98cf-47b3-99be-cc7b867b3080
